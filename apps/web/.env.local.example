# Public (safe for the browser bundle)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# Server-only. NEVER prefix with NEXT_PUBLIC_, never import this in a
# client component. Used only for admin actions (e.g. inviting a new
# business admin during onboarding) via src/lib/supabase/admin.ts.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Used to build absolute redirect URLs for invite emails (auth callback).
NEXT_PUBLIC_SITE_URL=http://localhost:3000
